// Grafana Alloy config: ship all Docker container logs to Loki.
// Container name (leading "/" stripped) becomes the "container" label.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.write.default.receiver]
}

// nginx writes real files (the ~/apps/nginx/logs mount replaces the image's
// stdout symlinks), so the edge access/error logs are tailed directly.
// Requires the compose mount: ~/apps/nginx/logs:/var/log/nginx:ro
local.file_match "nginx" {
	path_targets = [{
		__path__  = "/var/log/nginx/*.log",
		container = "nginx",
		source    = "file",
	}]
}

loki.source.file "nginx" {
	targets    = local.file_match.nginx.targets
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
