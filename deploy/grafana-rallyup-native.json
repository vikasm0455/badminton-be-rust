{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "title": "RallyUp · Native & Product",
  "uid": "rallyup-native",
  "tags": ["rallyup"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Requests by client (req/min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (client) (rate(http_requests_total[5m])) * 60", "legendFormat": "{{client}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Feature events by event (native)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (event) (increase(feature_events_total{client=\"native\"}[1h]))", "legendFormat": "{{event}}" }
      ]
    },
    {
      "type": "stat", "title": "⚠️ Refresh-token REUSE (theft signal, 24h)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(increase(token_refresh_total{result=\"reuse_revoked\"}[24h])) or vector(0)" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Token refresh outcomes",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (result) (increase(token_refresh_total[1h]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Push deliveries by platform",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (platform, result) (increase(push_sent_total[1h]))", "legendFormat": "{{platform}}/{{result}}" }
      ]
    },
    {
      "type": "timeseries", "title": "API p95 latency by endpoint (top mobile routes)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(http_request_duration_seconds_bucket{endpoint=~\"/api/(polls|reservations|credentials|groups|auth).*\"}[5m])))", "legendFormat": "{{endpoint}}" }
      ]
    }
  ]
}
