{
  "uid": "rallyup-api-health",
  "title": "RallyUp · API health",
  "tags": ["rallyup"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "API status",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"rallyup\"}",
          "instant": true,
          "legendFormat": "up"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "UP", "color": "green", "index": 0 },
                "0": { "text": "DOWN", "color": "red", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"rallyup\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "req/s"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Error rate (5xx, range)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=\"rallyup\",status=~\"5..\"}[$__range])) / clamp_min(sum(increase(http_requests_total{job=\"rallyup\"}[$__range])), 1e-10)",
          "instant": true,
          "legendFormat": "5xx ratio"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "noValue": "0%",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "p95 latency (range)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"rallyup\"}[$__range])))",
          "instant": true,
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 10,
      "title": "Traffic",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Requests/s by endpoint",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(http_requests_total{job=\"rallyup\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Requests/s by client",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client) (rate(http_requests_total{job=\"rallyup\"}[$__rate_interval]))",
          "legendFormat": "{{client}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Requests/s by status class",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (label_replace(rate(http_requests_total{job=\"rallyup\"}[$__rate_interval]), \"status_class\", \"${1}xx\", \"status\", \"([0-9])..\"))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "2xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "4xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 20,
      "title": "Latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Latency quantiles (overall)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"rallyup\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"rallyup\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"rallyup\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "p95 latency by endpoint",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{job=\"rallyup\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Hot mobile endpoints p95",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{job=\"rallyup\",endpoint=~\"/api/(polls|reservations|credentials)/today\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 30,
      "title": "Errors",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 31,
      "title": "5xx by endpoint",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(http_requests_total{job=\"rallyup\",status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "4xx by endpoint",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(http_requests_total{job=\"rallyup\",status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}} (all 4xx)"
        },
        {
          "refId": "B",
          "expr": "sum by (endpoint) (rate(http_requests_total{job=\"rallyup\",status=~\"4..\",status!=\"401\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}} (excl 401)"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 33,
      "title": "5xx ratio",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"rallyup\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=\"rallyup\"}[$__rate_interval])), 1e-10)",
          "legendFormat": "5xx ratio"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx ratio" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 40,
      "title": "Dependencies",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 41,
      "title": "Downstream req/s by dependency + status",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, status) (rate(downstream_requests_total{job=\"rallyup\"}[$__rate_interval]))",
          "legendFormat": "{{dependency}} {{status}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 42,
      "title": "Downstream error ratio by dependency",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency) (rate(downstream_requests_total{job=\"rallyup\",status!~\"2..\"}[$__rate_interval])) / clamp_min(sum by (dependency) (rate(downstream_requests_total{job=\"rallyup\"}[$__rate_interval])), 1e-10)",
          "legendFormat": "{{dependency}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 43,
      "title": "Downstream p95 latency by dependency",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(downstream_request_duration_seconds_bucket{job=\"rallyup\"}[$__rate_interval])))",
          "legendFormat": "{{dependency}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 50,
      "title": "Auth & push",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 51,
      "title": "Token refresh by result",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(token_refresh_total{job=\"rallyup\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "reuse_revoked" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 50 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ok" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "rejected" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 52,
      "title": "Push sent by platform + result",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (platform, result) (rate(push_sent_total{job=\"rallyup\"}[$__rate_interval]))",
          "legendFormat": "{{platform}} {{result}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
