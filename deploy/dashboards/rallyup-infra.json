{
  "uid": "rallyup-infra",
  "title": "RallyUp · Backend infra",
  "tags": ["rallyup"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Process (RallyUp API)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU cores used",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"rallyup\"}[$__rate_interval])",
          "legendFormat": "cpu cores",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"rallyup\"}",
          "legendFormat": "resident",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        },
        {
          "refId": "B",
          "expr": "process_virtual_memory_bytes{job=\"rallyup\"}",
          "legendFormat": "virtual",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Open file descriptors vs max",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "process_open_fds{job=\"rallyup\"}",
          "legendFormat": "open",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        },
        {
          "refId": "B",
          "expr": "process_max_fds{job=\"rallyup\"}",
          "legendFormat": "max",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 5, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Threads",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "process_threads{job=\"rallyup\"}",
          "legendFormat": "threads",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=\"rallyup\"}",
          "legendFormat": "uptime",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "System CPU cores",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "system_cpu_cores{job=\"rallyup\"}",
          "legendFormat": "cores",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "DB pool",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pool connections by state",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_connections{job=\"rallyup\"}",
          "legendFormat": "{{state}}",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Pool saturation (size / max)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_connections{job=\"rallyup\",state=\"size\"} / ignoring(state) db_pool_connections{job=\"rallyup\",state=\"max\"}",
          "legendFormat": "saturation",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Idle connections",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_connections{job=\"rallyup\",state=\"idle\"}",
          "legendFormat": "idle",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Containers",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Container CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{job=\"docker\",name=~\"badminton-be-rust|badminton-fe|postgres|redis|nginx|loki|alloy|grafana|prometheus\"}[$__rate_interval])",
          "legendFormat": "{{name}}",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Container memory (working set)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{job=\"docker\",name=~\"badminton-be-rust|badminton-fe|postgres|redis|nginx|loki|alloy|grafana|prometheus\"}",
          "legendFormat": "{{name}}",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Host",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Host CPU utilization",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "cpu used",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Host memory used",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})",
          "legendFormat": "mem used",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.92 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 18,
      "type": "gauge",
      "title": "Disk free (/)",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\"}",
          "legendFormat": "free",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "green", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Load average",
      "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=\"node-exporter\"}",
          "legendFormat": "load1",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        },
        {
          "refId": "B",
          "expr": "node_load5{job=\"node-exporter\"}",
          "legendFormat": "load5",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        },
        {
          "refId": "C",
          "expr": "node_load15{job=\"node-exporter\"}",
          "legendFormat": "load15",
          "datasource": { "type": "prometheus", "uid": "bfokl6oslozr4a" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 5, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
